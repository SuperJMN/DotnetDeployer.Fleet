<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:icons="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
             xmlns:converters="clr-namespace:DotnetDeployer.Fleet.App.Converters"
             x:Class="DotnetDeployer.Fleet.App.Views.ProjectsView"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="500"
             d:DesignWidth="400"
             x:DataType="vm:ProjectsViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
        </DataContextChangedTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <!-- Loading indicator -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,8" />

        <!-- Project list: card grid that adapts column count to width -->
        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <BalancedWrapGrid MinItemWidth="280"
                                          HorizontalSpacing="8"
                                          VerticalSpacing="8"
                                          VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ProjectViewModel">
                        <Grid>
                            <EnhancedButton Command="{Binding OpenCommand}"
                                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            ToolTip.Tip="Open project">
                                <Grid ColumnDefinitions="64,*"
                                      RowDefinitions="Auto,42"
                                      IsHitTestVisible="False">
                                    <StackPanel Grid.Column="1"
                                                Spacing="4"
                                                MinWidth="0">
                                        <TextBlock Text="{Binding Project.Name}"
                                                   FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding Project.GitUrl}"
                                                   Opacity="0.6" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Opacity="0.5">
                                            <Run Text="Branch: " />
                                            <Run Text="{Binding Project.Branch}" />
                                            <Run Text="  |  Polling: " />
                                            <Run Text="{Binding Project.PollingIntervalMinutes}" />
                                            <Run Text=" min" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </EnhancedButton>

                            <EnhancedButton Width="56"
                                            Height="56"
                                            Margin="12"
                                            Padding="6"
                                            CornerRadius="6"
                                            ClipToBounds="True"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            HorizontalContentAlignment="Stretch"
                                            VerticalContentAlignment="Stretch"
                                            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                            BorderThickness="1"
                                            ToolTip.Tip="Change icon"
                                            Command="{Binding ChangeIconCommand}">
                                <Grid>
                                    <Image Source="{Binding ProjectIconBytes, Converter={x:Static converters:ProjectIconConverters.ByteArrayToBitmap}}"
                                           Stretch="Uniform"
                                           IsVisible="{Binding HasProjectIcon}" />
                                    <icons:Icon Value="mdi-folder-outline"
                                                Width="28"
                                                Height="28"
                                                Opacity="0.65"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasNoProjectIcon}" />
                                </Grid>
                            </EnhancedButton>

                            <FlexPanel Wrap="Wrap"
                                       Gap="8"
                                       AlignItems="Center"
                                       JustifyContent="End"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="12">
                                <EnhancedButton ToolTip.Tip="Use automatic icon" Command="{Binding ResetIconCommand}">
                                    <icons:Icon Value="mdi-refresh" />
                                </EnhancedButton>
                                <EnhancedButton ToolTip.Tip="Edit" Command="{Binding EditCommand}">
                                    <icons:Icon Value="mdi-pencil" />
                                </EnhancedButton>
                                <EnhancedButton ToolTip.Tip="Delete" Classes="Destructive" Command="{Binding DeleteCommand}">
                                    <icons:Icon Value="mdi-delete-outline" />
                                </EnhancedButton>
                            </FlexPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
