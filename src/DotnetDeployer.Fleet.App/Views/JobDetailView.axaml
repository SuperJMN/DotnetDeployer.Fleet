<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:terminal="using:AvaloniaTerminal"
             xmlns:theming="clr-namespace:DotnetDeployer.Fleet.App.Theming"
             x:Class="DotnetDeployer.Fleet.App.Views.JobDetailView"
             x:DataType="vm:JobDetailViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
        </DataContextChangedTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <!-- Error banner: shown when the job has an ErrorMessage (Failed/Cancelled). -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasError}"
                Background="{DynamicResource ToneDangerBackgroundBrush}"
                BorderBrush="{DynamicResource ToneDangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <ContentControl Content="{Icon mdi-alert-circle}"
                                IconOptions.Size="20"
                                IconOptions.Fill="{DynamicResource ToneDangerBrush}"
                                VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="Job error" FontWeight="SemiBold" Foreground="{DynamicResource ToneDangerBrush}" />
                    <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </StackPanel>
                <EnhancedButton Grid.Column="2"
                                Content="Show error in log"
                                Icon="{Icon mdi-text-box-search-outline}"
                                Command="{Binding ShowErrorInLogCommand}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="Open the log at the first error line" />
            </Grid>
        </Border>

        <!-- NuGet verification: published packages are checked after the job succeeds. -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsNuGetVerificationPending}"
                Background="{DynamicResource ToneInfoBackgroundBrush}"
                BorderBrush="{DynamicResource ToneInfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ContentControl Content="{Icon mdi-progress-clock}"
                                IconOptions.Size="20"
                                IconOptions.Fill="{DynamicResource ToneInfoBrush}"
                                VerticalAlignment="Top" />
                <StackPanel Spacing="2">
                    <TextBlock Text="NuGet packages published" FontWeight="SemiBold" />
                    <TextBlock Text="Fleet is verifying that NuGet serves exactly the pushed packages once they are indexed. This can take a few minutes and does not affect the release."
                               TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top"
                IsVisible="{Binding IsNuGetVerified}"
                Background="{DynamicResource ToneSuccessBackgroundBrush}"
                BorderBrush="{DynamicResource ToneSuccessBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ContentControl Content="{Icon mdi-check-decagram}"
                                IconOptions.Size="20"
                                IconOptions.Fill="{DynamicResource ToneSuccessBrush}"
                                VerticalAlignment="Top" />
                <StackPanel Spacing="2">
                    <TextBlock Text="NuGet packages verified" FontWeight="SemiBold" Foreground="{DynamicResource ToneSuccessBrush}" />
                    <TextBlock Text="Every published package is downloadable and identical to what Fleet pushed."
                               TextWrapping="Wrap" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Current phase badge: shown while a phase is in flight -->
        <Border DockPanel.Dock="Top"
                IsVisible="{Binding HasCurrentPhase}"
                Background="{DynamicResource ToneInfoBackgroundBrush}"
                BorderBrush="{DynamicResource ToneInfoBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,0,0,8">
            <FlexPanel Wrap="Wrap" Gap="8" AlignItems="Center">
                <ContentControl Content="{Icon mdi-wrench}"
                                IconOptions.Size="14"
                                IconOptions.Fill="{DynamicResource ToneInfoBrush}"
                                VerticalAlignment="Center" />
                <TextBlock Text="Current phase:" FontWeight="SemiBold"
                           VerticalAlignment="Center" Opacity="0.8" />
                <TextBlock Text="{Binding CurrentPhaseDisplay}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </FlexPanel>
        </Border>

        <Expander DockPanel.Dock="Top"
                  Header="Package artifacts"
                  IsExpanded="True"
                  Margin="0,0,0,8"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Stretch"
                  IsVisible="{Binding HasArtifacts}">
            <ItemsControl ItemsSource="{Binding Artifacts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,6" Margin="0,2"
                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                CornerRadius="4">
                            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                           Opacity="0.65" VerticalAlignment="Center" />
                                <EnhancedButton Grid.Column="2" Content="Save"
                                                Icon="{Icon mdi-download}"
                                                Command="{Binding SaveCommand}"
                                                Grid.RowSpan="2" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Sha256Text}"
                                           FontFamily="Consolas,Courier New,monospace"
                                           FontSize="11" Opacity="0.55" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Expander>

        <Grid>
            <DockPanel IsVisible="{Binding !IsDetailedLogVisible}">
                <TextBlock DockPanel.Dock="Top"
                           Text="Phase status"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <TreeView ItemsSource="{Binding Phases}"
                                  IsVisible="{Binding HasPhases}">
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="True" />
                                </Style>
                            </TreeView.Styles>
                            <TreeView.ItemTemplate>
                                <TreeDataTemplate x:DataType="vm:JobPhaseRowContainer" ItemsSource="{Binding Content.Children}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <ContentControl Grid.Column="0" Content="{Binding Content.Icon}"
                                                        theming:Toned.Tone="{Binding Content.Tone}"
                                                        IconOptions.Size="14"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Content.DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Content.DurationText}"
                                                   Opacity="0.6" FontSize="11" Margin="8,0,0,0" />
                                    </Grid>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <TextBlock Text="No phase events yet."
                                   Opacity="0.6"
                                   IsVisible="{Binding !HasPhases}" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>

            <DockPanel IsVisible="{Binding IsDetailedLogVisible}">
                <!-- Toolbar: search + severity filter (wraps on narrow widths) -->
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                        Padding="8" Margin="0,0,0,8" CornerRadius="4">
                    <FlexPanel Wrap="Wrap" Gap="8" AlignItems="Center">
                        <TextBox Name="SearchBox"
                                 PlaceholderText="Search…" MinWidth="180"
                                 FlexPanel.Grow="1"
                                 Text="{Binding SearchText}" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                                   Text="{Binding SearchResultText}" />
                        <EnhancedButton Icon="{Icon mdi-chevron-down}" Padding="6,4"
                                        Command="{Binding NextSearchResultCommand}"
                                        ToolTip.Tip="Next match"
                                        AutomationProperties.Name="Next match" />
                        <ComboBox ItemsSource="{Binding SeverityFilters}"
                                  SelectedValueBinding="{Binding Minimum, DataType=vm:SeverityFilterOption}"
                                  DisplayMemberBinding="{Binding Label, DataType=vm:SeverityFilterOption}"
                                  SelectedValue="{Binding MinSeverity}"
                                  MinWidth="160"
                                  ToolTip.Tip="Which log lines to show" />
                        <EnhancedButton Content="Copy all" Icon="{Icon mdi-content-copy}"
                                        Command="{Binding CopyLogsCommand}"
                                        ToolTip.Tip="Copy every log line to the clipboard, including the ones the filter hides" />
                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.7"
                                   Text="{Binding CopyResultText}" />
                    </FlexPanel>
                </Border>

                <!-- Terminal log viewer (LAST child = fills remaining space) -->
                <terminal:TerminalControl Name="LogTerminal"
                                          Model="{Binding TerminalModel}"
                                          FontFamily="Consolas,Courier New,monospace"
                                          FontSize="12" />
            </DockPanel>
        </Grid>

    </DockPanel>

</UserControl>
