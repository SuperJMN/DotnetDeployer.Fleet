<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:views="clr-namespace:DotnetDeployer.Fleet.App.Views"
             x:Class="DotnetDeployer.Fleet.App.Views.AddProjectView"
             x:DataType="vm:AddProjectViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16"
                    MaxWidth="480"
                    HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="Name" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding Name}" PlaceholderText="My App" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Git URL" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding GitUrl}"
                         PlaceholderText="https://github.com/org/repo.git"
                         IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Branch" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding Branch}" PlaceholderText="main" IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <Panel IsEnabled="{Binding !IsBusy}">
                <views:PollingIntervalView DataContext="{Binding Polling}" />
            </Panel>

            <CheckBox Content="Run solution tests before deployment"
                      IsChecked="{Binding RunTestsBeforeDeploy}"
                      IsEnabled="{Binding !IsBusy}" />

            <StackPanel Spacing="4">
                <TextBlock Text="Pin NuGet package IDs (optional, comma or line separated). Leave empty to publish every packable project." Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding ExpectedPackageIdsText}"
                         PlaceholderText="All packable projects"
                         IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Access token (optional, for private HTTPS repos)" Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                <TextBox Text="{Binding GitToken}"
                         PasswordChar="●"
                         PlaceholderText="Personal access token"
                         IsEnabled="{Binding !IsBusy}" />
            </StackPanel>

            <TextBlock Text="{Binding Error}"
                       Foreground="Red"
                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                       TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
