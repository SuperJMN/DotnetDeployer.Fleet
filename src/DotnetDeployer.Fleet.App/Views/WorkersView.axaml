<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:icons="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
             x:Class="DotnetDeployer.Fleet.App.Views.WorkersView"
             x:DataType="vm:WorkersViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </DataContextChangedTrigger>
        <AttachedToVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </AttachedToVisualTreeTrigger>
        <DetachedFromVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StopCommand}" />
        </DetachedFromVisualTreeTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,8" />

        <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Workers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <BalancedWrapGrid MinItemWidth="260"
                                          HorizontalSpacing="8"
                                          VerticalSpacing="8"
                                          VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:WorkerItemViewModel">
                    <Border Padding="12"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <FlexPanel Wrap="Wrap" Gap="12" AlignItems="Center">
                                <StackPanel Spacing="4" MinWidth="200" FlexPanel.Grow="1">
                                    <FlexPanel Wrap="Wrap" Gap="8" AlignItems="Center">
                                        <TextBlock Text="{Binding Worker.Name}"
                                                   FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{Binding EmbeddedLabel}"
                                                   Opacity="0.5" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding Worker.Version, Converter={x:Static ObjectConverters.IsNotNull}}">
                                            <ContentControl Content="{Icon mdi-alert}"
                                                            IconOptions.Size="13"
                                                            IconOptions.Fill="#F0B72F"
                                                            VerticalAlignment="Center"
                                                            ToolTip.Tip="{Binding VersionMismatchMessage}"
                                                            IsVisible="{Binding VersionDiffers}" />
                                            <TextBlock Text="{Binding DisplayVersion}"
                                                       ToolTip.Tip="{Binding Worker.Version}"
                                                       Opacity="0.6" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="220" />
                                        </StackPanel>
                                    </FlexPanel>
                                    <TextBlock Text="{Binding CapabilityLabel}"
                                               ToolTip.Tip="{Binding Worker.CpuModel}"
                                               IsVisible="{Binding CapabilityLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="11" Opacity="0.7" />
                                    <FlexPanel Wrap="Wrap" Gap="8" AlignItems="Center">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="12" />
                                        <HyperlinkButton Padding="0"
                                                         FontSize="12"
                                                         Content="{Binding CurrentJobLabel}"
                                                         ToolTip.Tip="Open the build this worker is running"
                                                         Command="{Binding OpenCurrentJobCommand}"
                                                         IsVisible="{Binding CurrentJobLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    </FlexPanel>
                                    <TextBlock FontSize="11" Opacity="0.6">
                                        <Run Text="Last seen: " />
                                        <Run Text="{Binding LastSeenText}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Disk config -->
                                <StackPanel Spacing="4" MinWidth="200">
                                    <TextBlock Text="Max disk (GB)" FontSize="11" Opacity="0.7" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <NumericUpDown Grid.Column="0"
                                                       Value="{Binding MaxDiskUsageGb}"
                                                       Minimum="1" Maximum="500" Increment="1"
                                                       FormatString="N0" />
                                        <EnhancedButton Grid.Column="1"
                                                        Content="Save"
                                                        Icon="{Icon mdi-content-save}"
                                                        Command="{Binding SaveConfigCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                IsVisible="{Binding IsSaved}">
                                        <ContentControl Content="{Icon mdi-check}"
                                                        IconOptions.Size="13"
                                                        IconOptions.Fill="#43A047"
                                                        VerticalAlignment="Center" />
                                        <TextBlock Text="Saved" FontSize="11" Opacity="0.7"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </FlexPanel>

                            <!-- Removing a worker is rare and destructive: keep it behind a menu. -->
                            <EnhancedButton Grid.Column="1" VerticalAlignment="Top" ToolTip.Tip="More actions">
                                <EnhancedButton.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Remove worker…" Command="{Binding RemoveCommand}">
                                            <MenuItem.Icon>
                                                <icons:Icon Value="mdi-delete-outline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </EnhancedButton.Flyout>
                                <icons:Icon Value="mdi-dots-vertical" />
                            </EnhancedButton>
                        </Grid>
                    </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
