<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             x:Class="DotnetDeployer.Fleet.App.Views.BuildsView"
             x:DataType="vm:BuildsViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </DataContextChangedTrigger>
        <AttachedToVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </AttachedToVisualTreeTrigger>
        <DetachedFromVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StopCommand}" />
        </DetachedFromVisualTreeTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Error}"
                   Foreground="{DynamicResource ToneDangerBrush}"
                   Margin="0,0,0,8"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4"
                     Margin="0,0,0,8" />

        <Border DockPanel.Dock="Top" Classes="ListPlaceholder" IsVisible="{Binding BuildsStatus.IsLoadingFirstItems}">
            <StackPanel>
                <ProgressBar />
                <TextBlock Classes="Hint" Text="Loading builds…" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Classes="ListPlaceholder" IsVisible="{Binding BuildsStatus.IsEmpty}">
            <StackPanel>
                <TextBlock Classes="Title" Text="No builds yet" />
                <TextBlock Classes="Hint" Text="Open a project and use Queue Build or Queue Deploy to start one." />
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Builds}" />
        </ScrollViewer>

    </DockPanel>

</UserControl>
