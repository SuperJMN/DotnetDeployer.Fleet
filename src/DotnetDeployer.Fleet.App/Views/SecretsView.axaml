<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             x:Class="DotnetDeployer.Fleet.App.Views.SecretsView"
             x:DataType="vm:SecretsViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
        </DataContextChangedTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}"
                   Foreground="{DynamicResource ToneDangerBrush}" Margin="0,0,0,8"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" Height="4" Margin="0,0,0,8" />

        <!-- One scroll for the whole page, so the list keeps its room on short screens. -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">

                <!-- Two forms: side-by-side on wide, stacked on narrow. Each form keeps its own
                     height when stacked, so no empty space is left above the list. -->
                <FlexPanel Wrap="Wrap" Gap="8">
                    <!-- Add new secret -->
                    <Border FlexPanel.Basis="300" FlexPanel.Grow="1"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Add secret" FontWeight="SemiBold" />
                            <FlexPanel Wrap="Wrap" Gap="8" AlignItems="Center">
                                <TextBox Text="{Binding NewName}"
                                         Watermark="Name (e.g. GITHUB_TOKEN)"
                                         MinWidth="160"
                                         FlexPanel.Grow="1" />
                                <TextBox Text="{Binding NewValue}"
                                         Watermark="Value"
                                         PasswordChar="●"
                                         Classes="revealPasswordButton"
                                         MinWidth="160"
                                         FlexPanel.Grow="1" />
                                <EnhancedButton Content="Add" Icon="{Icon mdi-plus}"
                                                Classes="Primary"
                                                Command="{Binding AddCommand}" />
                            </FlexPanel>
                        </StackPanel>
                    </Border>

                    <!-- Import from .env -->
                    <Border FlexPanel.Basis="300" FlexPanel.Grow="1"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1"
                            CornerRadius="6" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Import from .env" FontWeight="SemiBold" />
                            <TextBlock Text="Select a .env file to import its key=value entries as global secrets. You will see what is created and what is overwritten before anything changes."
                                       TextWrapping="Wrap" Opacity="0.7" />
                            <EnhancedButton Content="Choose .env file…"
                                            Icon="{Icon mdi-file-import-outline}"
                                            HorizontalAlignment="Left"
                                            Command="{Binding ImportFromEnvCommand}" />
                        </StackPanel>
                    </Border>
                </FlexPanel>

                <!-- Secret list: card grid -->
                <ItemsControl ItemsSource="{Binding Secrets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <BalancedWrapGrid MinItemWidth="300"
                                              HorizontalSpacing="8"
                                              VerticalSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SecretViewModel">
                            <Border Padding="12"
                                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Panel>
                                    <!-- View mode: a fixed two-column row, so the actions sit in the same
                                         place on every card whatever the length of the name. -->
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditing}">
                                        <StackPanel Grid.Column="0" Spacing="2"
                                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="Consolas,monospace"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="●●●●●●●●" Opacity="0.5" FontSize="10" />
                                                <TextBlock Text="Saved" Opacity="0.6" FontSize="10"
                                                           IsVisible="{Binding IsSaved}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                    VerticalAlignment="Center">
                                            <EnhancedButton Icon="{Icon mdi-pencil}"
                                                            ToolTip.Tip="Edit"
                                                            AutomationProperties.Name="Edit"
                                                            Command="{Binding EditCommand}" />
                                            <EnhancedButton Icon="{Icon mdi-delete-outline}"
                                                            ToolTip.Tip="Delete"
                                                            AutomationProperties.Name="Delete"
                                                            Command="{Binding DeleteCommand}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Edit mode: the value stays hidden until the eye button shows it -->
                                    <StackPanel Spacing="8" IsVisible="{Binding IsEditing}">
                                        <TextBox Text="{Binding Name}"
                                                 Watermark="Name" />
                                        <TextBox Text="{Binding Value}"
                                                 Watermark="Value"
                                                 PasswordChar="●"
                                                 Classes="revealPasswordButton"
                                                 RevealPassword="{Binding IsValueRevealed, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    HorizontalAlignment="Right">
                                            <EnhancedButton Content="Cancel" Icon="{Icon mdi-close}"
                                                            Classes="Cancel"
                                                            Command="{Binding CancelCommand}" />
                                            <EnhancedButton Content="Save" Icon="{Icon mdi-content-save}"
                                                            Classes="Primary"
                                                            Command="{Binding SaveCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
