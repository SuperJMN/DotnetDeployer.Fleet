<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:views="clr-namespace:DotnetDeployer.Fleet.App.Views"
             x:Class="DotnetDeployer.Fleet.App.Views.ProjectDetailView"
             x:DataType="vm:ProjectDetailViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </DataContextChangedTrigger>
        <AttachedToVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StartCommand}" />
        </AttachedToVisualTreeTrigger>
        <DetachedFromVisualTreeTrigger>
            <InvokeCommandAction Command="{Binding AutoRefresh.StopCommand}" />
        </DetachedFromVisualTreeTrigger>
    </Interaction.Behaviors>

    <UserControl.Styles>
        <!-- Wide screens get aligned columns; narrow ones a one-column list without horizontal scroll. -->
        <Style Selector="ScrollViewer.Compact">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <ContainerQuery Name="ProjectDetailRoot" Query="max-width:799">
            <Style Selector="TableView.Wide">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="ScrollViewer.Compact">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </ContainerQuery>
    </UserControl.Styles>

    <DockPanel Margin="16" Container.Name="ProjectDetailRoot" Container.Sizing="Width">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Error}"
                   Foreground="{DynamicResource ToneDangerBrush}"
                   Margin="0,0,0,8"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4"
                     Margin="0,0,0,8" />

        <Grid>
            <Border IsVisible="{Binding ShowEmptyJobHistory}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6"
                    Padding="24"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="6"
                            MaxWidth="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No builds or deployments yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Use Queue Deploy or Queue Build above to enqueue the first run."
                               Opacity="0.7"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Panel IsVisible="{Binding HasJobHistory}">
                <!-- Wide: aligned columns; the whole row opens the job. -->
                <TableView Classes="Wide"
                           ItemsSource="{Binding Jobs}"
                           views:TableRowActivation.IsEnabled="True">
                    <TableView.Columns>
                        <TableViewColumn Header="Version" Width="2*">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:JobViewModel">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="{Binding Version}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        <TableViewColumn Header="Kind" Width="90" Binding="{Binding KindText}" />
                        <TableViewColumn Header="Status" Width="250">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:JobViewModel">
                                    <views:JobStatusLabel />
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                        <TableViewColumn Header="Finished" Width="150" Binding="{Binding FinishedText}" />
                        <TableViewColumn Header="Duration" Width="90" Binding="{Binding ElapsedText}" />
                        <TableViewColumn Header="Commit" Width="90">
                            <TableViewColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:JobViewModel">
                                    <TextBlock Text="{Binding ShortCommitSha, FallbackValue='--', TargetNullValue='--'}"
                                               ToolTip.Tip="{Binding Job.TriggerCommitSha}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </TableViewColumn.CellTemplate>
                        </TableViewColumn>
                    </TableView.Columns>
                </TableView>

                <!-- Narrow: one compact row per job. -->
                <ScrollViewer Classes="Compact" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Jobs}" />
                </ScrollViewer>
            </Panel>
        </Grid>

    </DockPanel>

</UserControl>
