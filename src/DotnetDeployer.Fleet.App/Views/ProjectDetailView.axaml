<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             x:Class="DotnetDeployer.Fleet.App.Views.ProjectDetailView"
             x:DataType="vm:ProjectDetailViewModel">

    <Interaction.Behaviors>
        <DataContextChangedTrigger>
            <InvokeCommandAction Command="{Binding RefreshCommand}" />
        </DataContextChangedTrigger>
    </Interaction.Behaviors>

    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding Error}"
                   Foreground="Red"
                   Margin="0,0,0,8"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <ProgressBar DockPanel.Dock="Top"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}"
                     Height="4"
                     Margin="0,0,0,8" />

        <Grid>
            <Border IsVisible="{Binding ShowEmptyJobHistory}"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    CornerRadius="6"
                    Padding="24"
                    HorizontalAlignment="Stretch">
                <StackPanel Spacing="6"
                            MaxWidth="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="No builds or deployments yet"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Use Queue Deploy or Queue Build above to enqueue the first run."
                               Opacity="0.7"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasJobHistory}">
                <ItemsControl ItemsSource="{Binding Jobs}" />
            </ScrollViewer>
        </Grid>

    </DockPanel>

</UserControl>
