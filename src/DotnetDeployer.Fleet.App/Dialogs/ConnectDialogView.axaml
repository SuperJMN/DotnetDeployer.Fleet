<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.Dialogs"
             x:Class="DotnetDeployer.Fleet.App.Dialogs.ConnectDialogView"
             x:DataType="vm:ConnectDialogViewModel">

    <StackPanel Spacing="12">

        <TextBlock Text="Enter the coordinator endpoint URL:" Opacity="0.7" />

        <TextBox Text="{Binding EndpointUrl}"
                 Watermark="http://localhost:5000"
                 IsEnabled="{Binding !IsBusy}" />

        <ProgressBar IsIndeterminate="True" Height="4"
                     IsVisible="{Binding IsBusy}" />

        <TextBlock Text="{Binding Error}"
                   Foreground="{DynamicResource ToneDangerBrush}"
                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                   TextWrapping="Wrap" />

    </StackPanel>

</UserControl>
