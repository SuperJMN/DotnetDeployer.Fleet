<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:misc="clr-namespace:Zafiro.Avalonia.Misc;assembly=Zafiro.Avalonia"
             xmlns:icons="clr-namespace:Optris.Icons.Avalonia;assembly=Optris.Icons.Avalonia"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.ViewModels"
             xmlns:zac="clr-namespace:Zafiro.Avalonia.Controls;assembly=Zafiro.Avalonia"
             x:Class="DotnetDeployer.Fleet.App.App">

    <!-- Status colours per theme. Each tone has a foreground for text and icons, plus a
         background and a border for callouts. Theming.Toned picks Tone{Tone}Brush by name. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToneNeutralBrush" Color="#57606A" />
                    <SolidColorBrush x:Key="ToneInfoBrush" Color="#0969DA" />
                    <SolidColorBrush x:Key="ToneSuccessBrush" Color="#1A7F37" />
                    <SolidColorBrush x:Key="ToneWarningBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="ToneDangerBrush" Color="#CF222E" />

                    <SolidColorBrush x:Key="ToneInfoBackgroundBrush" Color="#DDF4FF" />
                    <SolidColorBrush x:Key="ToneInfoBorderBrush" Color="#54AEFF" />
                    <SolidColorBrush x:Key="ToneSuccessBackgroundBrush" Color="#DAFBE1" />
                    <SolidColorBrush x:Key="ToneSuccessBorderBrush" Color="#4AC26B" />
                    <SolidColorBrush x:Key="ToneDangerBackgroundBrush" Color="#FFEBE9" />
                    <SolidColorBrush x:Key="ToneDangerBorderBrush" Color="#FF8182" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToneNeutralBrush" Color="#8B949E" />
                    <SolidColorBrush x:Key="ToneInfoBrush" Color="#58A6FF" />
                    <SolidColorBrush x:Key="ToneSuccessBrush" Color="#3FB950" />
                    <SolidColorBrush x:Key="ToneWarningBrush" Color="#F0B72F" />
                    <SolidColorBrush x:Key="ToneDangerBrush" Color="#F85149" />

                    <SolidColorBrush x:Key="ToneInfoBackgroundBrush" Color="#1F2A3A" />
                    <SolidColorBrush x:Key="ToneInfoBorderBrush" Color="#3A5A8A" />
                    <SolidColorBrush x:Key="ToneSuccessBackgroundBrush" Color="#1F3A24" />
                    <SolidColorBrush x:Key="ToneSuccessBorderBrush" Color="#2E7D32" />
                    <SolidColorBrush x:Key="ToneDangerBackgroundBrush" Color="#3A1F1F" />
                    <SolidColorBrush x:Key="ToneDangerBorderBrush" Color="#8B2C2C" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Zafiro.Avalonia/Styles.axaml" />
        <StyleInclude Source="avares://Zafiro.Avalonia.Dialogs/Styles.axaml" />
        <StyleInclude Source="avares://AvaloniaTerminal/Styles/Colors.axaml" />

        <Style Selector="icons|Icon">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style Selector="Frame">
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Table cells line up on the row's centre, whether they show plain text or a template. -->
        <Style Selector="TableViewCell">
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- What a list shows instead of its items while it loads or when it has none. -->
        <Style Selector="Border.ListPlaceholder">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.ListPlaceholder > StackPanel">
            <Setter Property="Spacing" Value="8" />
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.ListPlaceholder TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.ListPlaceholder TextBlock.Title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ListPlaceholder TextBlock.Hint">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.ListPlaceholder ProgressBar">
            <Setter Property="IsIndeterminate" Value="True" />
            <Setter Property="Width" Value="200" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <misc:DataTemplateInclude Source="avares://Zafiro.Avalonia/DataTemplates.axaml" />
        <NamingConventionGeneratedViewLocator />
        <DataTypeViewLocator />

        <DataTemplate DataType="vm:SectionHeader">
            <FlexPanel Wrap="Wrap" AlignItems="Center"
                       RowGap="8" ColumnGap="12" Margin="16,12,16,8">
                <StackPanel Spacing="2" FlexPanel.Grow="1" MinWidth="160">
                    <TextBlock Text="{Binding Title}"
                               FontSize="20" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}"
                               FontSize="12" Opacity="0.6"
                               TextWrapping="Wrap"
                               IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <FlexPanel Wrap="Wrap" RowGap="8" ColumnGap="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HeaderAction">
                            <Panel>
                                <!-- Primary: icon + text -->
                                <zac:EnhancedButton Content="{Binding Text}"
                                                    Command="{Binding Command}"
                                                    Classes="Primary"
                                                    IsVisible="{Binding IsPrimaryCommand}">
                                    <zac:EnhancedButton.Icon>
                                        <icons:Icon Value="{Binding IconCode}" />
                                    </zac:EnhancedButton.Icon>
                                </zac:EnhancedButton>
                                <zac:EnhancedButton Content="{Binding Text}"
                                                    Command="{Binding Command}"
                                                    Classes="Destructive"
                                                    IsVisible="{Binding IsDestructiveCommand}">
                                    <zac:EnhancedButton.Icon>
                                        <icons:Icon Value="{Binding IconCode}" />
                                    </zac:EnhancedButton.Icon>
                                </zac:EnhancedButton>
                                <!-- Secondary: icon-only with tooltip and accessible name (icon as Content to bypass Zafiro 51.9.0 IconPresenter bug) -->
                                <zac:EnhancedButton Command="{Binding Command}"
                                                    ToolTip.Tip="{Binding Text}"
                                                    AutomationProperties.Name="{Binding Text}"
                                                    IsVisible="{Binding IsSecondaryCommand}">
                                    <icons:Icon Value="{Binding IconCode}" />
                                </zac:EnhancedButton>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </FlexPanel>
        </DataTemplate>
    </Application.DataTemplates>

</Application>
