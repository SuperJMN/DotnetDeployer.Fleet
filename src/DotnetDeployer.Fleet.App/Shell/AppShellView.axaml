<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.Shell"
             xmlns:shell="clr-namespace:Zafiro.Avalonia.Controls.Shell;assembly=Zafiro.Avalonia"
             xmlns:conv="clr-namespace:DotnetDeployer.Fleet.App.Converters"
             x:Class="DotnetDeployer.Fleet.App.Shell.AppShellView"
             x:DataType="vm:AppShellViewModel">

    <DockPanel>

        <!-- Backend health status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <EnhancedButton Command="{Binding ReconnectCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip.Tip="Click to change endpoint or reconnect">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Fill="{Binding BackendHealth, Converter={x:Static conv:HealthConverters.ToBrush}}" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding BackendHealth, Converter={x:Static conv:HealthConverters.ToLabel}}" />
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding BackendEndpoint}" />
                        <StackPanel Grid.Column="3"
                                    Margin="8,0"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <ContentControl Content="{Icon mdi-alert}"
                                            IconOptions.Size="14"
                                            IconOptions.Fill="#F0B72F"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{Binding VersionMismatchMessage}"
                                            IsVisible="{Binding VersionsDiffer}" />
                            <TextBlock VerticalAlignment="Center"
                                       Opacity="0.6"
                                       FontSize="11"
                                       Text="{Binding AppDisplayVersion, StringFormat='GUI {0}'}"
                                       ToolTip.Tip="{Binding AppVersion}"
                                       IsVisible="{Binding AppVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Opacity="0.6"
                                       FontSize="11"
                                       Text="{Binding BackendDisplayVersion, StringFormat='Coordinator {0}'}"
                                       ToolTip.Tip="{Binding BackendVersion}"
                                       IsVisible="{Binding BackendVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <TextBlock Grid.Column="4"
                                   VerticalAlignment="Center"
                                   Opacity="0.6"
                                   FontSize="11"
                                   Text="{Binding BackendHealthMessage}"
                                   IsVisible="{Binding BackendHealthMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </EnhancedButton>
            </Grid>
        </Border>

        <shell:ShellView DataContext="{Binding Shell}" />

    </DockPanel>

</UserControl>
