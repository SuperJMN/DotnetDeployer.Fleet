<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DotnetDeployer.Fleet.App.Shell"
             xmlns:shell="clr-namespace:Zafiro.Avalonia.Controls.Shell;assembly=Zafiro.Avalonia"
             xmlns:conv="clr-namespace:DotnetDeployer.Fleet.App.Converters"
             x:Class="DotnetDeployer.Fleet.App.Shell.AppShellView"
             x:DataType="vm:AppShellViewModel">

    <DockPanel>

        <!-- Backend health status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <EnhancedButton Command="{Binding ReconnectCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Cursor="Hand"
                                ToolTip.Tip="Click to change endpoint or reconnect">
                    <!-- Wraps the versions onto a second line when the screen is too narrow. -->
                    <FlexPanel Wrap="Wrap" ColumnGap="10" RowGap="2" AlignItems="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" FlexPanel.Grow="1">
                            <Ellipse Width="10" Height="10"
                                     VerticalAlignment="Center"
                                     Fill="{Binding BackendHealth, Converter={x:Static conv:HealthConverters.ToBrush}}" />
                            <TextBlock FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Text="{Binding BackendHealth, Converter={x:Static conv:HealthConverters.ToLabel}}" />
                            <TextBlock Opacity="0.7"
                                       VerticalAlignment="Center"
                                       Text="{Binding BackendEndpoint}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Opacity" Value="0.6" />
                                    <Setter Property="FontSize" Value="11" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Styles>
                            <ContentControl Content="{Icon mdi-alert}"
                                            IconOptions.Size="14"
                                            IconOptions.Fill="#F0B72F"
                                            ToolTip.Tip="{Binding VersionMismatchMessage}"
                                            IsVisible="{Binding VersionsDiffer}" />
                            <TextBlock Text="{Binding AppDisplayVersion, StringFormat='GUI {0}'}"
                                       ToolTip.Tip="{Binding AppVersion}"
                                       IsVisible="{Binding AppVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding BackendDisplayVersion, StringFormat='Coordinator {0}'}"
                                       ToolTip.Tip="{Binding BackendVersion}"
                                       IsVisible="{Binding BackendVersion, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding BackendHealthMessage}"
                                       IsVisible="{Binding BackendHealthMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </FlexPanel>
                </EnhancedButton>
            </Grid>
        </Border>

        <shell:ShellView DataContext="{Binding Shell}" />

    </DockPanel>

</UserControl>
